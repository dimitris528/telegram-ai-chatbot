# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_TOKEN=123456789:replace-with-your-telegram-bot-token
# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-replace-with-your-openai-api-key

# ---------------------------------------------------------------------------
# LLM (optional)
# ---------------------------------------------------------------------------
OPENAI_MODEL=gpt-4o-mini
# SYSTEM_PROMPT=You are a helpful, concise assistant chatting on Telegram.
# Seconds before an OpenAI request is abandoned, and automatic retries on transient errors
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Conversation memory (optional)
# ---------------------------------------------------------------------------
# Approximate token budget of chat history sent to the model per request
MAX_HISTORY_TOKENS=3000
# Messages retained per chat in the database (older ones are pruned)
MAX_STORED_MESSAGES=50
DB_PATH=data/conversations.db

# ---------------------------------------------------------------------------
# Rate limiting & UX (optional)
# ---------------------------------------------------------------------------
# Max messages each user may send per window
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=60
# Stream tokens into the Telegram message as they are generated
STREAM_REPLIES=true
# Minimum seconds between streaming edits (Telegram flood-control friendly)
STREAM_EDIT_INTERVAL=1.0
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Webhook mode (optional). Leave WEBHOOK_URL empty to use long polling.
# ---------------------------------------------------------------------------
# Public HTTPS base URL; the bot serves updates at <WEBHOOK_URL>/telegram
WEBHOOK_URL=
PORT=8080
# Random string Telegram echoes back so forged requests are rejected
WEBHOOK_SECRET=
